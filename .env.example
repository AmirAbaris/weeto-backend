# Server
PORT=8080
ENV=development

# Database
# Host-side dev (make dev): use localhost
DB_URL=postgres://weeto:weeto@localhost:5432/weeto?sslmode=disable
# Docker compose: DB_URL is overridden in docker-compose.yml (hostname: postgres)

# Auth
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
SESSION_COOKIE_SECURE=false

# Google OAuth (signup + Calendar/Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match {FRONTEND_URL}/api/integrations/google/callback (registered in Google Cloud Console)
GOOGLE_REDIRECT_URL=http://localhost:3000/api/integrations/google/callback

# Encryption key for stored Google refresh tokens (32 bytes, base64)
TOKEN_ENCRYPTION_KEY=

# Email (Resend)
RESEND_TOKEN_KEY=
RESEND_FROM=Weeto <noreply@weeto.ir>

# SMS (Kavenegar or Melipayamak — TBD)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# Frontend (CORS, OAuth redirects)
FRONTEND_URL=http://localhost:3000
