# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://weeto:weeto@localhost:5432/weeto?sslmode=disable

# Auth
JWT_SECRET=change-me
SESSION_COOKIE_SECURE=false

# Google OAuth (signup + Calendar/Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Encryption key for stored Google refresh tokens (32 bytes, base64)
TOKEN_ENCRYPTION_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@weeto.ir

# SMS (Kavenegar or Melipayamak — TBD)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# Frontend (CORS, OAuth redirects)
FRONTEND_URL=http://localhost:3000
